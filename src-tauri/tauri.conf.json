{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelForge AI",
  "version": "2.7.2",
  "identifier": "com.novelforge.ai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovelForge AI — 专业多 Agent 长篇小说创作系统",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": true,
        "center": true,
        "focus": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MjIwRDE5ODFCMEQ2M0MKUldRODFyQ0JHUTBpeFh4RHM4MlMwNmJucUZQSUIra1NMcTZTUUJLWDdqaTdGeGlzc0Nma3JrVkkK",
      "endpoints": [
        "https://github.com/S2mpleX/novelforge/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/S2mpleX/novelforge/releases/latest/download/latest.json"
      ]
    }
  }
}
